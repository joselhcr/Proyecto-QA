{
  "name": "tic-tac-toe-backend",
  "version": "1.0.0",
  "description": "Backend for Tic Tac Toe application with authentication and leaderboard.",
  "main": "server.js",
  "scripts": {
    "start": "nodemon server.js",
    "dev": "nodemon server.js",
    "test": "jest --runInBand --forceExit --detectOpenHandles",
    "test:integration": "jest --runInBand tests/integration --forceExit --detectOpenHandles",
    "test:security": "jest --testPathPattern=tests/security --forceExit --detectOpenHandles",
    "test:perf": "jest --testPathPattern=tests/performance --forceExit",
    "test:all": "jest --runInBand --forceExit --detectOpenHandles"
  },
  "dependencies": {
    "body-parser": "^1.20.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.8.3",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/supertest": "^6.0.2",
    "@types/ws": "^8.5.13",
    "docx": "^9.7.1",
    "jest": "^30.4.2",
    "mongodb-memory-server": "^11.2.0",
    "nodemon": "^2.0.22",
    "supertest": "^7.2.2"
  },
  "keywords": [
    "tic-tac-toe",
    "backend",
    "authentication",
    "leaderboard",
    "express",
    "game"
  ],
  "author": "Son Nguyen",
  "license": "MIT"
}
